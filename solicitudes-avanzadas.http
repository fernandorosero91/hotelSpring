### ============================================================================
### Contratos Polimórficos, Proyecciones Anidadas y Actualización Parcial Segura
### Archivo de pruebas ejecutable (IntelliJ HTTP Client / VS Code REST Client)
### ============================================================================

@host = http://localhost:8080

### ----------------------------------------------------------------------------
### PREPARACIÓN (prerrequisito para las pruebas 3 y 4)
### Crea un cliente con una reserva para poder consultar su resumen.
### Ejecutar una vez; captura automáticamente los IDs en variables globales.
### ----------------------------------------------------------------------------

### Preparación 1: crear un cliente
POST {{host}}/api/clientes
Content-Type: application/json

{
  "nombre": "Ana Pérez",
  "email": "ana.perez@example.com"
}

> {%
    client.test("201 Created", function () {
        client.assert(response.status === 201, "Se esperaba 201 Created");
    });
    client.global.set("clienteId", response.body.id);
%}

### Preparación 2: crear una habitación estándar
POST {{host}}/api/habitaciones/estandar
Content-Type: application/json

{
  "numero": "E01-101",
  "precioPorNoche": 120.0,
  "capacidadMaxima": 2,
  "camasIndividuales": 2
}

> {%
    client.global.set("habitacionId", response.body.id);
%}

### Preparación 3: crear una reserva para el cliente
POST {{host}}/api/reservas
Content-Type: application/json

{
  "clienteId": "{{clienteId}}",
  "habitacionId": "{{habitacionId}}",
  "fechaInicio": "2026-10-01T15:00:00",
  "fechaFin": "2026-10-05T15:00:00"
}

> {%
    client.global.set("reservaId", response.body.id);
%}


### ============================================================================
### PRUEBA 1 — Creación de Suite Presidencial
### Esperado: 201 Created con el ID generado y los campos propios de la suite.
### ============================================================================

### Prueba 1: POST /api/habitaciones/suites
POST {{host}}/api/habitaciones/suites
Content-Type: application/json

{
  "numero": "P05-501",
  "precioPorNoche": 350.0,
  "capacidadMaxima": 2,
  "jacuzziPrivado": true,
  "incluyeMayordomo": true
}

> {%
    client.test("Respuesta 201 Created", function () {
        client.assert(response.status === 201, "Se esperaba 201 Created");
    });
    client.test("Incluye ID generado", function () {
        client.assert(response.body.id !== undefined && response.body.id !== null, "Falta el ID generado");
    });
    client.test("Discriminador tipo = SUITE", function () {
        client.assert(response.body.tipo === "SUITE", "Se esperaba tipo SUITE");
    });
    client.test("Conserva atributos específicos de la suite", function () {
        client.assert(response.body.jacuzziPrivado === true, "jacuzziPrivado debe ser true");
        client.assert(response.body.incluyeMayordomo === true, "incluyeMayordomo debe ser true");
    });
%}


### ============================================================================
### PRUEBA 2 — Consulta Polimórfica
### Esperado: un JSON array donde conviven estándar y suite, cada elemento con
### su campo "tipo" y sus atributos propios, sin errores de casteo.
### ============================================================================

### Prueba 2: GET /api/habitaciones
GET {{host}}/api/habitaciones
Accept: application/json

> {%
    client.test("Respuesta 200 OK", function () {
        client.assert(response.status === 200, "Se esperaba 200 OK");
    });
    client.test("Es un array polimórfico", function () {
        client.assert(Array.isArray(response.body), "Se esperaba un array");
    });
    client.test("Cada elemento trae discriminador tipo", function () {
        response.body.forEach(function (h) {
            client.assert(h.tipo === "ESTANDAR" || h.tipo === "SUITE",
                "tipo inválido en habitación " + h.numero);
        });
    });
%}


### ============================================================================
### PRUEBA 3 — Resumen Ejecutivo del Cliente
### Esperado: datos del cliente + total de reservas + monto total gastado +
### lista embebida limpia (sin $ref cíclicos ni desbordamiento).
### ============================================================================

### Prueba 3: GET /api/clientes/{id}/resumen
GET {{host}}/api/clientes/{{clienteId}}/resumen
Accept: application/json

> {%
    client.test("Respuesta 200 OK", function () {
        client.assert(response.status === 200, "Se esperaba 200 OK");
    });
    client.test("Calcula totalReservasRealizadas", function () {
        client.assert(response.body.totalReservasRealizadas === 1,
            "Se esperaba 1 reserva, se obtuvo " + response.body.totalReservasRealizadas);
    });
    client.test("Calcula montoTotalGastado", function () {
        client.assert(response.body.montoTotalGastado === 480.0,
            "Se esperaba 480.0 (120.0 x 4 noches), se obtuvo " + response.body.montoTotalGastado);
    });
    client.test("Lista embebida sin referencia al cliente", function () {
        response.body.reservasRecientes.forEach(function (r) {
            client.assert(r.numeroHabitacion !== undefined, "Falta numeroHabitacion");
            client.assert(r.cliente === undefined, "No debe referenciar al cliente");
        });
    });
%}


### ============================================================================
### PRUEBA 4 — Actualización Selectiva (PATCH)
### Esperado: 200 OK; sólo cambia el nombre. El email, activo y penalizaciones
### permanecen inalterados.
### ============================================================================

### Prueba 4: PATCH /api/clientes/{id} enviando únicamente el nombre
PATCH {{host}}/api/clientes/{{clienteId}}
Content-Type: application/json

{
  "nombre": "Nuevo Nombre Modificado"
}

> {%
    client.test("Respuesta 200 OK", function () {
        client.assert(response.status === 200, "Se esperaba 200 OK");
    });
    client.test("El nombre fue actualizado", function () {
        client.assert(response.body.nombre === "Nuevo Nombre Modificado",
            "El nombre no se actualizó");
    });
    client.test("El email permaneció inalterado", function () {
        client.assert(response.body.email === "ana.perez@example.com",
            "El email fue sobrescrito: " + response.body.email);
    });
    client.test("Estado activo y penalizaciones intactos", function () {
        client.assert(response.body.activo === true, "activo cambió");
        client.assert(response.body.penalizaciones === 0, "penalizaciones cambió");
    });
%}
